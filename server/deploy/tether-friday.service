[Unit]
Description=Tether local Friday voice worker
After=network.target tether-llm.service

[Service]
# Set TETHER_REPO to the checkout that contains server/friday_agent.py.
Environment=TETHER_REPO=%h/apps/tether
Environment=HF_HUB_OFFLINE=1
ExecStart=%h/.local/share/tether/friday-venv/bin/python ${TETHER_REPO}/server/friday_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
