[
  {
    "id": "classic",
    "name": "Classic",
    "description": "Today\u2019s Tether: the sessions list, the chat and the tabs.",
    "panels": [
      "activity",
      "sessions",
      "chat",
      "agents"
    ],
    "grid": {
      "columns": [
        {
          "main": "activity"
        },
        {
          "main": "sessions",
          "width": 248
        },
        {
          "main": "chat"
        }
      ]
    },
    "style": {
      "radius": 0,
      "gap": 0,
      "surface": "flat"
    },
    "theme": null
  },
  {
    "id": "status",
    "name": "Status column",
    "description": "A right column shows every agent, grouped by what it needs.",
    "panels": [
      "sessions",
      "chat",
      "agents",
      "status"
    ],
    "grid": {
      "columns": [
        {
          "main": "sessions",
          "width": 220
