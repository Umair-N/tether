    "style": {
      "radius": 0,
      "gap": 0,
      "surface": "flat"
    },
    "theme": null
  },
  {
    "id": "islands",
    "name": "Islands",
    "description": "Floating cards on a night stage. What waits on you sits over the sessions.",
    "panels": [
      "waiting",
      "sessions",
      "chat",
      "agents"
    ],
    "grid": {
      "columns": [
        {
          "top": "waiting",
          "main": "sessions",
          "width": 250
        },
        {
          "main": "chat"
        }
      ]
    },
    "style": {
      "radius": 16,
      "gap": 10,
      "surface": "flat"
    },
    "themeName": "Night islands",
    "theme": {
      "bg": "#0b0a1a",
      "sidebar": "#16132e",
      "surface": "#181434",
      "bubble": "#221d47",
      "text": "#ecebff",
      "muted": "#a19bd0",
      "line": "#2e2862",
      "hover": "#2a2458",
      "accent": "#a78bfa",
      "accentText": "#120d2b",
      "attention": "#fbbf24",
      "done": "#4ade80",
      "pin": "#7dd3fc",
      "error": "#fb7185"
    }
  },
  {
