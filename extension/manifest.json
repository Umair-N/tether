{
  "manifest_version": 3,
  "name": "Tether browser",
  "description": "Use one approved Chrome tab from Tether. Click the extension to stop control.",
  "version": "1.0.0",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "Tether: connect or stop"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:"}
}
