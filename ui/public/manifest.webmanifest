{
  "id": "/chat/",
  "name": "Tether",
  "short_name": "Tether",
  "description": "Chat with your tmux sessions: Claude, Codex, and terminals.",
  "start_url": "/chat/",
  "scope": "/chat/",
  "display_override": ["window-controls-overlay"],
  "display": "standalone",
  "background_color": "#262624",
  "theme_color": "#262624",
  "icons": [
    {
      "src": "/chat/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/chat/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/chat/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/chat/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/chat/icon-monochrome-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "/chat/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "share_target": {
    "action": "/chat/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            ".log",
            ".md",
            ".json",
            ".csv"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Needs you",
      "short_name": "Needs you",
      "description": "Open the first chat that waits for you",
      "url": "/chat/?go=attention",
      "icons": [
        {
          "src": "/chat/shortcut-attention.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New session",
      "short_name": "New",
      "description": "Start a Claude, Codex or terminal session",
      "url": "/chat/?go=new",
      "icons": [
        {
          "src": "/chat/shortcut-new.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Usage",
      "short_name": "Usage",
      "description": "Plan limits for Claude and Codex",
      "url": "/chat/?go=usage",
      "icons": [
        {
          "src": "/chat/shortcut-usage.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
